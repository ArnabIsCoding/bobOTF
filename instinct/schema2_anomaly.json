{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Anomaly flag (Instinct -> Memory)",
  "type": "object",
  "required": ["device_id", "timestamp", "anomaly_type", "severity", "signature", "description"],
  "additionalProperties": false,
  "properties": {
    "device_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "anomaly_type": {
      "type": "string",
      "enum": ["vibration_drift", "thermal_creep", "bearing_wear", "other"]
    },
    "severity": { "type": "number", "minimum": 0, "maximum": 1 },
    "signature": {
      "type": "object",
      "required": ["baseline", "current", "deviation_pct"],
      "additionalProperties": false,
      "properties": {
        "baseline": { "type": "object" },
        "current": { "type": "object" },
        "deviation_pct": { "type": "number" }
      }
    },
    "description": { "type": "string", "minLength": 1 }
  }
}
